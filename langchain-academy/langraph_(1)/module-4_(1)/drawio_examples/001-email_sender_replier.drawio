                </mxCell>
                <mxCell id="gU2XfVmn8jiYd7o9YRNh-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#FF3333;fontColor=#393C56;fillColor=none;strokeWidth=3;" value="" vertex="1">
                    <mxGeometry height="67" width="137" x="29" y="102" as="geometry"/>
                </mxCell>
                <UserObject label="&lt;div style=&quot;color: #d4d4d4;background-color: #1e1e1e;font-family: &#39;Operator Mono Lig&#39;, Menlo, Monaco, &#39;Courier New&#39;, monospace;font-weight: 500;font-size: 14px;line-height: 21px;white-space: pre;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;def&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #dcdcaa;&quot;&gt;summarize_conversation&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #9cdcfe;&quot;&gt;state&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;: State):&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;    &lt;/span&gt;&lt;span style=&quot;color: #6a9955;&quot;&gt;# First, we get any existing summary&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;    summary = state.get(&lt;/span&gt;&lt;span style=&quot;color: #ce9178;&quot;&gt;&quot;summary&quot;&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: #ce9178;&quot;&gt;&quot;&quot;&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;    &lt;/span&gt;&lt;span style=&quot;color: #6a9955;&quot;&gt;# Create our summarization prompt&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;    &lt;/span&gt;&lt;span style=&quot;color: #c586c0;&quot;&gt;if&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt; summary:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;        &lt;/span&gt;&lt;span style=&quot;color: #6a9955;&quot;&gt;# A summary already exists&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;        summary_message = (&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;            &lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;f&lt;/span&gt;&lt;span style=&quot;color: #ce9178;&quot;&gt;&quot;This is summary of the conversation to date: &lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;summary&lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #d7ba7d;&quot;&gt;\n\n&lt;/span&gt;&lt;span style=&quot;color: #ce9178;&quot;&gt;&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;            &lt;/span&gt;&lt;span style=&quot;color: #ce9178;&quot;&gt;&quot;Extend the summary by taking into account the new messages above:&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;        )&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;    &lt;/span&gt;&lt;span style=&quot;color: #c586c0;&quot;&gt;else&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;        summary_message = &lt;/span&gt;&lt;span style=&quot;color: #ce9178;&quot;&gt;&quot;Create a summary of the conversation above:&quot;&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;    &lt;/span&gt;&lt;span style=&quot;color: #6a9955;&quot;&gt;# Add prompt to our history&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;    messages = state[&lt;/span&gt;&lt;span style=&quot;color: #ce9178;&quot;&gt;&quot;messages&quot;&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;] + [HumanMessage(&lt;/span&gt;&lt;span style=&quot;color: #9cdcfe;&quot;&gt;content&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;=summary_message)]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;    response: AIMessage = model.invoke(messages)&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;    &lt;/span&gt;&lt;span style=&quot;color: #6a9955;&quot;&gt;# Delete all but the 2 most recent messages&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;    delete_messages = [RemoveMessage(&lt;/span&gt;&lt;span style=&quot;color: #9cdcfe;&quot;&gt;id&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;=m.id) &lt;/span&gt;&lt;span style=&quot;color: #c586c0;&quot;&gt;for&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt; m &lt;/span&gt;&lt;span style=&quot;color: #c586c0;&quot;&gt;in&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt; state[&lt;/span&gt;&lt;span style=&quot;color: #ce9178;&quot;&gt;&quot;messages&quot;&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;][:-&lt;/span&gt;&lt;span style=&quot;color: #b5cea8;&quot;&gt;2&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;]]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;    &lt;/span&gt;&lt;span style=&quot;color: #c586c0;&quot;&gt;return&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt; {&lt;/span&gt;&lt;span style=&quot;color: #ce9178;&quot;&gt;&quot;summary&quot;&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;: response.content, &lt;/span&gt;&lt;span style=&quot;color: #ce9178;&quot;&gt;&quot;messages&quot;&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;: delete_messages}&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" id="gU2XfVmn8jiYd7o9YRNh-5">
                    <mxCell parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#393C56;labelBackgroundColor=default;" vertex="1">
                        <mxGeometry height="490" width="610" x="470" y="190" as="geometry"/>
                    </mxCell>
                </UserObject>
                <mxCell id="gU2XfVmn8jiYd7o9YRNh-7" edge="1" parent="1" source="gU2XfVmn8jiYd7o9YRNh-6" style="edgeStyle=orthogonalEdgeStyle;shape=connector;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#393C56;labelBackgroundColor=default;endArrow=classic;fillColor=#d5e8d4;" target="gU2XfVmn8jiYd7o9YRNh-5">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="gU2XfVmn8jiYd7o9YRNh-6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#FF3333;fontColor=#393C56;fillColor=none;strokeWidth=3;" value="" vertex="1">
                    <mxGeometry height="67" width="224" x="55" y="201" as="geometry"/>
                </mxCell>
                <mxCell id="gU2XfVmn8jiYd7o9YRNh-8" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#393C56;labelBackgroundColor=default;" value="&lt;div style=&quot;color: #d4d4d4;background-color: #1e1e1e;font-family: &#39;Operator Mono Lig&#39;, Menlo, Monaco, &#39;Courier New&#39;, monospace;font-weight: 500;font-size: 14px;line-height: 21px;white-space: pre;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: #6a9955;&quot;&gt;# Determine whether to end or summarize the conversation&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;def&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #dcdcaa;&quot;&gt;should_continue&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #9cdcfe;&quot;&gt;state&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;: State) -&amp;gt; Literal[&lt;/span&gt;&lt;span style=&quot;color: #ce9178;&quot;&gt;&quot;summarize_conversation&quot;&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;, END]:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;    &lt;/span&gt;&lt;span style=&quot;color: #ce9178;&quot;&gt;&quot;&quot;&quot;Return the next node to execute.&quot;&quot;&quot;&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;    messages = state[&lt;/span&gt;&lt;span style=&quot;color: #ce9178;&quot;&gt;&quot;messages&quot;&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;]&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;    &lt;/span&gt;&lt;span style=&quot;color: #6a9955;&quot;&gt;# If there are more than six messages, then we summarize the conversation&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;    &lt;/span&gt;&lt;span style=&quot;color: #c586c0;&quot;&gt;if&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #dcdcaa;&quot;&gt;len&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;(messages) &amp;gt; &lt;/span&gt;&lt;span style=&quot;color: #b5cea8;&quot;&gt;6&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;        &lt;/span&gt;&lt;span style=&quot;color: #c586c0;&quot;&gt;return&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #ce9178;&quot;&gt;&quot;summarize_conversation&quot;&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;    &lt;/span&gt;&lt;span style=&quot;color: #6a9955;&quot;&gt;# Otherwise we can just end&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;    &lt;/span&gt;&lt;span style=&quot;color: #c586c0;&quot;&gt;return&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt; END&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="260" width="600" x="-690" y="98" as="geometry"/>
                </mxCell>
                <mxCell id="gU2XfVmn8jiYd7o9YRNh-10" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#393C56;labelBackgroundColor=default;" value="&lt;div style=&quot;color: #d4d4d4;background-color: #1e1e1e;font-family: &#39;Operator Mono Lig&#39;, Menlo, Monaco, &#39;Courier New&#39;, monospace;font-weight: 500;font-size: 14px;line-height: 21px;white-space: pre;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: #6a9955;&quot;&gt;# LLM&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;model = ChatOpenAI(&lt;/span&gt;&lt;span style=&quot;color: #9cdcfe;&quot;&gt;model&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: #ce9178;&quot;&gt;&quot;gpt-4o&quot;&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: #9cdcfe;&quot;&gt;temperature&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: #b5cea8;&quot;&gt;0&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #6a9955;&quot;&gt;# State&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;class&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #4ec9b0;&quot;&gt;State&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #4ec9b0;&quot;&gt;MessagesState&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;):&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;    summary: &lt;/span&gt;&lt;span style=&quot;color: #4ec9b0;&quot;&gt;str&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="160" width="380" x="-40.5" y="-390" as="geometry"/>
                </mxCell>
                <mxCell id="gU2XfVmn8jiYd7o9YRNh-11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#d6b656;fillColor=none;strokeWidth=2;" value="" vertex="1">
                    <mxGeometry height="18" width="144" x="615" y="54" as="geometry"/>
                </mxCell>
