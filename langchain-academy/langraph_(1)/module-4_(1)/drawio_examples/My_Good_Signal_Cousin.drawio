        <mxCell id="910Ma0oTt8lAmsGQ-pzh-51" value="&lt;font color=&quot;#ff3333&quot;&gt;The &lt;/font&gt;&lt;font color=&quot;#000000&quot;&gt;OutputEmitterRef&#39;s subscribe() method&lt;/font&gt;&lt;font color=&quot;#ff3333&quot;&gt; allows us to define a event handler for the output signal.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=21;fontColor=#00FF00;labelBackgroundColor=none;" parent="1" vertex="1">
