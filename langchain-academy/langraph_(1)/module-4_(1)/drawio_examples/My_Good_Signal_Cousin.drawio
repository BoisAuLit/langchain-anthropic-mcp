        <mxCell id="EPgjI7OVuLiAbaIIqSfn-106" value="&lt;div&gt;&lt;font color=&quot;#ff3333&quot;&gt;&lt;b&gt;&lt;i&gt;when&amp;nbsp;&lt;/i&gt;&lt;/b&gt;&lt;/font&gt;specifies a condition when it becomes true, it&#39;ll load the &lt;b&gt;&lt;i&gt;deferred content&lt;/i&gt;&lt;/b&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;spacingLeft=3;spacingRight=3;align=left;verticalAlign=middle;" parent="1" vertex="1">
