        <mxCell id="EPgjI7OVuLiAbaIIqSfn-107" value="&lt;font&gt;This is a &lt;b&gt;&lt;i&gt;one-time operation&lt;/i&gt;&lt;/b&gt;– the @defer block does &lt;b&gt;&lt;i&gt;not revert&lt;/i&gt;&lt;/b&gt; back to the placeholder if the condition changes to a falsy value after becoming truthy.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#000000;labelBackgroundColor=default;spacingLeft=3;spacingRight=3;align=left;verticalAlign=top;" parent="1" vertex="1">
