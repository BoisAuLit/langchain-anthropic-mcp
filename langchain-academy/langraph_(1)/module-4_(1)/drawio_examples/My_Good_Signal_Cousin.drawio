        </mxCell>
        <mxCell id="HYzRC4N9WjUmbwJ38pO1-3" value="Select a &lt;b&gt;&lt;i&gt;property&lt;/i&gt;&lt;/b&gt; that &lt;b&gt;&lt;i&gt;uniquely identifies&lt;/i&gt;&lt;/b&gt; each item in the track expression." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=none;fillColor=#e1d5e7;strokeColor=#9673a6;spacingLeft=3;" parent="1" vertex="1">
