        <mxCell id="IW0Dy12oR7b7uJ1DvJFa-3" value="&lt;span style=&quot;font-size: 18px;&quot;&gt;To change the signal&#39;s value, we can do this.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontColor=#000000;" parent="1" vertex="1">
