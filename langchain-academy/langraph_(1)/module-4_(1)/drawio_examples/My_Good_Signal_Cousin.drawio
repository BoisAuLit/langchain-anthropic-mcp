        <mxCell id="EPgjI7OVuLiAbaIIqSfn-4" value="The @placeholder block accepts an &lt;b&gt;&lt;i&gt;optional parameter&lt;/i&gt;&lt;/b&gt; to specify the &lt;b&gt;&lt;i&gt;minimum amount of time&lt;/i&gt;&lt;/b&gt; that this placeholder should be shown &lt;i&gt;&lt;u&gt;after the placeholder content initially renders&lt;/u&gt;&lt;/i&gt;." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;spacingLeft=3;spacingRight=3;align=left;verticalAlign=middle;" parent="1" vertex="1">
