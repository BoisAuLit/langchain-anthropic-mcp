        <mxCell id="-ioxa-UHcmzAtseuXicP-28" value="&lt;span style=&quot;font-size: 22px;&quot;&gt;Required signals CANNOT have a default value, so&lt;/span&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;we cannot access it in the constructor&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;but we can access it in&lt;/span&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;ngOnInit()&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;ngOnChanges()&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;computed()&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;effect()&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=22;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;spacingLeft=6;spacingRight=5;" parent="1" vertex="1">
