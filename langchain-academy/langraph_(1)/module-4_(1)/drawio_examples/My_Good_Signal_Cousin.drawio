        <mxCell id="EPgjI7OVuLiAbaIIqSfn-37" value="&lt;div&gt;The triggers are used to control when Angular loads &amp;amp; displays deferred content.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;spacingLeft=3;spacingRight=3;align=left;verticalAlign=top;" parent="1" vertex="1">
