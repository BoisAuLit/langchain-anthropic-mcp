        </mxCell>
        <mxCell id="EPgjI7OVuLiAbaIIqSfn-38" value="&lt;div&gt;&lt;b&gt;&lt;i&gt;Multiple event triggers&lt;/i&gt;&lt;/b&gt; can be defined by separating them with a &lt;b&gt;&lt;i&gt;semicolon&lt;/i&gt;&lt;/b&gt;, ; and will be evaluated as &lt;b&gt;&lt;i&gt;OR conditions&lt;/i&gt;&lt;/b&gt;.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;spacingLeft=3;spacingRight=3;align=left;verticalAlign=top;" parent="1" vertex="1">
