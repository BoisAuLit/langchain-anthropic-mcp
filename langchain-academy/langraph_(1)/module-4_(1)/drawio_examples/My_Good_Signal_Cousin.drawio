        <mxCell id="910Ma0oTt8lAmsGQ-pzh-50" value="&lt;font style=&quot;font-size: 21px;&quot;&gt;&lt;font color=&quot;#ff3333&quot;&gt;The type is&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-family: monospace; font-size: 21px;&quot;&gt;&lt;b style=&quot;&quot;&gt;OutputEmitterRef&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=21;fontColor=#00FF00;labelBackgroundColor=none;" parent="1" vertex="1">
