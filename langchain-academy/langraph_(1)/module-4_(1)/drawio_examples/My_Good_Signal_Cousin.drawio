        <mxCell id="EPgjI7OVuLiAbaIIqSfn-11" value="The @loading block is an optional block that allows you to declare content that is shown &lt;b&gt;&lt;i&gt;&lt;u&gt;while deferred dependencies are loading&lt;/u&gt;&lt;/i&gt;&lt;/b&gt;. &lt;i&gt;&lt;font color=&quot;#ff3333&quot;&gt;It replaces the @placeholder block once loading is triggered&lt;/font&gt;&lt;/i&gt;." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;spacingLeft=3;spacingRight=3;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1110" y="1059.3899999999999" width="251.77" height="60" as="geometry" />
        </mxCell>
