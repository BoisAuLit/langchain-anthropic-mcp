  <diagram id="EWeuqi_8SP8Gc9wb6PHx" name="change detection">
    <mxGraphModel dx="1127" dy="758" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="KphUUlTLoXe1AmDpJxca-6" value="How to refactor?" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontColor=default;labelBackgroundColor=default;spacingLeft=3;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="20" y="800" width="1090" height="290" as="geometry" />
        </mxCell>
        <mxCell id="Cqgd0cK9M-cXbCeTwkZG-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=3;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;fillColor=#f8cecc;" edge="1" parent="1" source="Cqgd0cK9M-cXbCeTwkZG-1" target="Cqgd0cK9M-cXbCeTwkZG-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Cqgd0cK9M-cXbCeTwkZG-1" value="&lt;b&gt;&lt;i&gt;what is&lt;/i&gt;&lt;/b&gt; change detection?" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=none;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="30" y="35" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Cqgd0cK9M-cXbCeTwkZG-2" value="Change detection&amp;nbsp;is the process of checking to see &lt;b&gt;&lt;i&gt;if something&lt;/i&gt;&lt;/b&gt; in your Angular application has &lt;b&gt;&lt;i&gt;changed&lt;/i&gt;&lt;/b&gt;, and then &lt;b&gt;&lt;i&gt;rendering&lt;/i&gt;&lt;/b&gt; the &lt;b&gt;&lt;i&gt;changes&lt;/i&gt;&lt;/b&gt; to the &lt;b&gt;&lt;i&gt;DOM&lt;/i&gt;&lt;/b&gt; so the user can see the &lt;b&gt;&lt;i&gt;updated application&lt;/i&gt;&lt;/b&gt;." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;align=left;verticalAlign=top;spacingLeft=3;spacingRight=3;" vertex="1" parent="1">
          <mxGeometry x="210" y="15" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="Cqgd0cK9M-cXbCeTwkZG-4" value="How is it &lt;b&gt;&lt;i&gt;implemented&lt;/i&gt;&lt;/b&gt; in Angular?" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=none;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="30" y="120" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Cqgd0cK9M-cXbCeTwkZG-5" value="It&#39;s done with &lt;b&gt;&lt;i&gt;&lt;font color=&quot;#ff3333&quot;&gt;Zone.js&lt;/font&gt;&lt;/i&gt;&lt;/b&gt;.&lt;div&gt;-&amp;nbsp;Zone.js is a library that patches &lt;b&gt;&lt;i&gt;asynchronous operations&lt;/i&gt;&lt;/b&gt; (like &lt;b&gt;&lt;i&gt;setTimeout&lt;/i&gt;&lt;/b&gt;, &lt;b&gt;&lt;i&gt;Promises&lt;/i&gt;&lt;/b&gt;, and &lt;b&gt;&lt;i&gt;events&lt;/i&gt;&lt;/b&gt;) to keep track of changes in your application and automatically update the UI.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;align=left;verticalAlign=top;spacingLeft=3;spacingRight=3;" vertex="1" parent="1">
          <mxGeometry x="210" y="107.5" width="340" height="65" as="geometry" />
        </mxCell>
        <mxCell id="Cqgd0cK9M-cXbCeTwkZG-6" value="How does zone.js work ?" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=none;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="25" y="210" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Cqgd0cK9M-cXbCeTwkZG-7" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;imageBorder=default;" vertex="1" parent="1">
          <mxGeometry x="210" y="210" width="465.52" height="180" as="geometry" />
        </mxCell>
