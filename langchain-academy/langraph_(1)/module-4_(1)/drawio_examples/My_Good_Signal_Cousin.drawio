        <mxCell id="IW0Dy12oR7b7uJ1DvJFa-1" value="&lt;font style=&quot;font-size: 21px;&quot;&gt;Since this is 2-way binding, child&#39;s modification on the signal can be seen by the parent.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=21;fontColor=#FF0000;" parent="1" vertex="1">
