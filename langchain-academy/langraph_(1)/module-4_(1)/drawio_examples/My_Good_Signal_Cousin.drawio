          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="705" y="865.5" />
              <mxPoint x="705" y="865.5" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="886Jd54ZS-ncFoHV00ty-28" value="From Angular official doc, this should be done with caution, cuz it may make it more vulnerable to &lt;b&gt;&lt;i&gt;XSS attacks&lt;/i&gt;&lt;/b&gt;." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=4;" parent="1" vertex="1">
