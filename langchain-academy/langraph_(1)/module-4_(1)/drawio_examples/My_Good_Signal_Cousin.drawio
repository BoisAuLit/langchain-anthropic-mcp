        <mxCell id="EPgjI7OVuLiAbaIIqSfn-10" value="Show loading content with &lt;b&gt;&lt;i&gt;@loading&lt;/i&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
