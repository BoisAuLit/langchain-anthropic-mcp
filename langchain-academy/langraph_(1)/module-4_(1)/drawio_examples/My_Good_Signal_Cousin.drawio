        <mxCell id="886Jd54ZS-ncFoHV00ty-25" value="If we declare it like this (instead of using any), we can enable &lt;b&gt;&lt;i&gt;IntelliSense&lt;/i&gt;&lt;/b&gt;." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=none;fillColor=#e1d5e7;strokeColor=#9673a6;spacingLeft=3;" parent="1" vertex="1">
