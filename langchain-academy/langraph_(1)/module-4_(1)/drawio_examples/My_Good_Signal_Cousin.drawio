        <mxCell id="Wi65gJVvPcgQ2sFjNc0l-3" value="Basic syntax" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
