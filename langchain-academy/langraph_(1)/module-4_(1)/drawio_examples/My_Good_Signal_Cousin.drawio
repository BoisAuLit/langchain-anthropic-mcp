        <mxCell id="Wi65gJVvPcgQ2sFjNc0l-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#b85450;strokeWidth=3;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;fillColor=#f8cecc;" parent="1" source="Wi65gJVvPcgQ2sFjNc0l-7" target="Wi65gJVvPcgQ2sFjNc0l-12" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Wi65gJVvPcgQ2sFjNc0l-7" value="In order for @defer to work, it should meet &lt;b&gt;&lt;i&gt;2 conditions&lt;/i&gt;&lt;/b&gt;." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;spacingLeft=3;spacingRight=3;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="1118.23" y="415" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Wi65gJVvPcgQ2sFjNc0l-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=3;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;fillColor=#f8cecc;" parent="1" source="Wi65gJVvPcgQ2sFjNc0l-8" target="Wi65gJVvPcgQ2sFjNc0l-9" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Wi65gJVvPcgQ2sFjNc0l-8" value="It must be standalone.&lt;div style=&quot;font-size: 9px;&quot;&gt;- stadalone components&lt;/div&gt;&lt;div style=&quot;font-size: 9px;&quot;&gt;- standalone directives&lt;/div&gt;&lt;div style=&quot;font-size: 9px;&quot;&gt;- standalone pipes&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fontColor=default;labelBackgroundColor=default;spacingLeft=3;spacingRight=3;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="1340" y="370" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Wi65gJVvPcgQ2sFjNc0l-9" value="Because &lt;b&gt;&lt;i&gt;non-standalone&lt;/i&gt;&lt;/b&gt; components &lt;b&gt;&lt;i&gt;&lt;u&gt;cannot be deferred&lt;/u&gt;&lt;/i&gt;&lt;/b&gt;, and they are &lt;b&gt;&lt;i&gt;eagerly loaded&lt;/i&gt;&lt;/b&gt;." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;spacingLeft=3;spacingRight=3;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1490" y="385" width="250" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Wi65gJVvPcgQ2sFjNc0l-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=3;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;fillColor=#f8cecc;" parent="1" source="Wi65gJVvPcgQ2sFjNc0l-12" target="Wi65gJVvPcgQ2sFjNc0l-14" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Wi65gJVvPcgQ2sFjNc0l-12" value="It cannot be referenced &lt;b&gt;&lt;i&gt;&lt;u&gt;outside @defer blocks within the same file&lt;/u&gt;&lt;/i&gt;&lt;/b&gt;." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;spacingLeft=3;spacingRight=3;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1340" y="450" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Wi65gJVvPcgQ2sFjNc0l-14" value="If they are referenced &lt;b&gt;&lt;i&gt;outside the @defer block&lt;/i&gt;&lt;/b&gt; or referenced within &lt;b&gt;&lt;i&gt;ViewChild&lt;/i&gt;&lt;/b&gt; queries, the dependencies will be &lt;b&gt;&lt;i&gt;eagerly loaded&lt;/i&gt;&lt;/b&gt;." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;spacingLeft=3;spacingRight=3;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1570" y="435" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="qxC_x09aG5_iH0gzdCrg-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=3;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;fillColor=#f8cecc;" parent="1" source="qxC_x09aG5_iH0gzdCrg-1" target="qxC_x09aG5_iH0gzdCrg-3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qxC_x09aG5_iH0gzdCrg-1" value="The block inside @defer will be loaded in the following cases:&lt;div&gt;- A &lt;b&gt;&lt;i&gt;trigger&lt;/i&gt;&lt;/b&gt; occurs.&lt;/div&gt;&lt;div&gt;- The &lt;b&gt;&lt;i&gt;when condition&lt;/i&gt;&lt;/b&gt; is met.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=none;fillColor=#e1d5e7;strokeColor=#9673a6;spacingLeft=3;" parent="1" vertex="1">
          <mxGeometry x="1295" y="237.5" width="320" height="55" as="geometry" />
        </mxCell>
        <mxCell id="qxC_x09aG5_iH0gzdCrg-3" value="&lt;b&gt;&lt;i&gt;By default&lt;/i&gt;&lt;/b&gt;, a @defer block is triggered when the browser state becomes &lt;b&gt;&lt;i&gt;idle&lt;/i&gt;&lt;/b&gt;." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=none;fillColor=#e1d5e7;strokeColor=#9673a6;spacingLeft=3;" parent="1" vertex="1">
          <mxGeometry x="1650" y="238.75" width="160" height="52.5" as="geometry" />
        </mxCell>
        <mxCell id="UXTe15T1eyuMNEUT1H_h-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=3;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;fillColor=#f8cecc;" parent="1" source="qxC_x09aG5_iH0gzdCrg-5" target="qxC_x09aG5_iH0gzdCrg-6" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qxC_x09aG5_iH0gzdCrg-5" value="Show placeholder" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="910" y="620" width="130" height="30" as="geometry" />
        </mxCell>
        <mxCell id="qxC_x09aG5_iH0gzdCrg-6" value="By default, defer blocks do not render any content before they are triggered.By default, defer blocks do not render any content before they are triggered." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;spacingLeft=3;spacingRight=3;align=left;verticalAlign=middle;" parent="1" vertex="1">
