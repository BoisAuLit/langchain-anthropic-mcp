          <mxGeometry x="2410" y="523" width="130" height="16" as="geometry" />
        </mxCell>
        <mxCell id="886Jd54ZS-ncFoHV00ty-64" value="The final rendered version in the DOM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="2400" y="427.5" width="130" height="30" as="geometry" />
        </mxCell>
        <mxCell id="886Jd54ZS-ncFoHV00ty-81" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#b85450;strokeWidth=3;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;fillColor=#f8cecc;" parent="1" source="886Jd54ZS-ncFoHV00ty-65" target="886Jd54ZS-ncFoHV00ty-66" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2590" y="565.5" />
              <mxPoint x="2590" y="552.5" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="886Jd54ZS-ncFoHV00ty-65" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FF3333;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="2410" y="557" width="110" height="16" as="geometry" />
        </mxCell>
        <mxCell id="886Jd54ZS-ncFoHV00ty-66" value="These are the &lt;b style=&quot;font-size: 9px;&quot;&gt;&lt;i style=&quot;font-size: 9px;&quot;&gt;anchors&lt;/i&gt;&lt;/b&gt; for the two &lt;b style=&quot;font-size: 9px;&quot;&gt;&lt;i style=&quot;font-size: 9px;&quot;&gt;&amp;lt;ng-container&amp;gt;&lt;/i&gt;&lt;/b&gt; in the template. Note that:&lt;div&gt;1. For an &lt;b&gt;&amp;lt;ng-container&amp;gt;&lt;/b&gt;, the anchor is &lt;b&gt;&amp;lt;!--ngcontainer--&amp;gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;2. For a &lt;b&gt;&amp;lt;div&amp;gt;&lt;/b&gt;, the anchor is &lt;b&gt;&amp;lt;!--container&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=9;labelBackgroundColor=none;fillColor=#e1d5e7;strokeColor=#9673a6;spacingLeft=3;" parent="1" vertex="1">
          <mxGeometry x="2625.5" y="523" width="264.5" height="58.5" as="geometry" />
        </mxCell>
        <mxCell id="886Jd54ZS-ncFoHV00ty-69" value="For &lt;b&gt;&lt;i&gt;*ngIf&lt;/i&gt;&lt;/b&gt;, the &lt;b&gt;&lt;i&gt;anchor&lt;/i&gt;&lt;/b&gt; looks like this" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;align=left;verticalAlign=top;spacingLeft=3;" parent="1" vertex="1">
          <mxGeometry x="2415" y="642.5" width="265" height="180" as="geometry" />
        </mxCell>
        <mxCell id="886Jd54ZS-ncFoHV00ty-70" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="2430" y="686.5" width="220.9" height="21" as="geometry" />
        </mxCell>
        <mxCell id="886Jd54ZS-ncFoHV00ty-71" value="The initial version in the temaplte" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="2430" y="666.5" width="195.5" height="14" as="geometry" />
        </mxCell>
        <mxCell id="886Jd54ZS-ncFoHV00ty-72" value="The final rendered version in the DOM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="2430" y="720.5" width="230" height="14" as="geometry" />
        </mxCell>
        <mxCell id="886Jd54ZS-ncFoHV00ty-73" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="2430" y="742.5" width="223.5" height="70" as="geometry" />
        </mxCell>
        <mxCell id="886Jd54ZS-ncFoHV00ty-74" value="For this one, the original &lt;b&gt;&lt;i&gt;native element&lt;/i&gt;&lt;/b&gt; is a &lt;b&gt;&lt;i&gt;div&lt;/i&gt;&lt;/b&gt;, but we are reading it as a &lt;b&gt;&lt;i&gt;ViewContainerRef&lt;/i&gt;&lt;/b&gt;." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=none;fillColor=#e1d5e7;strokeColor=#9673a6;spacingLeft=3;" parent="1" vertex="1">
          <mxGeometry x="2150" y="657.5" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="886Jd54ZS-ncFoHV00ty-75" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#33FF33;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="2110" y="633.5" width="220" height="18" as="geometry" />
        </mxCell>
        <mxCell id="886Jd54ZS-ncFoHV00ty-76" value="For this one, the original &lt;b&gt;&lt;i&gt;native element&lt;/i&gt;&lt;/b&gt; is a &lt;b&gt;&lt;i&gt;&amp;lt;ng-container&amp;gt;&lt;/i&gt;&lt;/b&gt;, but we are reading it as a &lt;b&gt;&lt;i&gt;ViewContainerRef&lt;/i&gt;&lt;/b&gt;." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=none;fillColor=#e1d5e7;strokeColor=#9673a6;spacingLeft=3;" parent="1" vertex="1">
