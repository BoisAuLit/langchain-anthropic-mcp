        <mxCell id="EPgjI7OVuLiAbaIIqSfn-8" value="We do this to &lt;i&gt;&lt;u&gt;&lt;b&gt;prevent fast flickering&lt;/b&gt;&lt;/u&gt;&lt;/i&gt; of placeholder content." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;spacingLeft=3;spacingRight=3;align=left;verticalAlign=middle;" parent="1" vertex="1">
