                <mxCell id="c86" parent="c85" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" value="search_query: str　　把整段对话压成一条检索词" vertex="1">
