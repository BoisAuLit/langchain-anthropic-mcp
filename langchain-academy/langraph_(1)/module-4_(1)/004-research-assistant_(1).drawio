                <mxCell id="c84" parent="c78" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" value="sections: list　　访谈小结（子图内普通覆盖；回父图才被 add 合并）" vertex="1">
